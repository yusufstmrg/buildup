    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.4.0",
    "lucide-react": "^0.344.0",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "puppeteer": "^25.11.0",
    "react": "^18.2.0",
    "react-beautiful-dnd": "^13.1.1",
    "react-colorful": "^5.8.1",
